# --- Compte admin (Espace Admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<genere avec: python -c "import bcrypt; print(bcrypt.hashpw(b'motdepasse', bcrypt.gensalt()).decode())">

# --- Session ---
SESSION_SECRET_KEY=<genere avec: python -c "import secrets; print(secrets.token_hex(32))">

# --- Base de donnees ---
DATABASE_PATH=db/tunoova.db

# --- Bibliotheque musicale locale ---
MP3_LIBRARY_PATH=./mp3
MP3_SCAN_INTERVAL_MINUTES=15
# Taille max (Mo) d'un envoi de MP3 depuis Admin > MP3
MP3_UPLOAD_MAX_MB=200

# --- Email (SMTP) : demandes de compte / reset mot de passe ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Cles API externes ---
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# --- Jobs planifies (syntaxe crontab) ---
JOB_MP3_SCAN_CRON=*/15 * * * *
JOB_MP3_SCAN_ENABLED=1
JOB_MUSIC_PURGE_CRON=0 4 1 * *
JOB_MUSIC_PURGE_ENABLED=1
JOB_RSS_POLL_CRON=*/30 * * * *
JOB_RSS_POLL_ENABLED=1
JOB_DB_BACKUP_CRON=0 3 * * *
JOB_DB_BACKUP_ENABLED=1
JOB_CAST_SCAN_CRON=*/5 * * * *
JOB_CAST_SCAN_ENABLED=1
JOB_LOG_PURGE_CRON=30 4 * * *
JOB_LOG_PURGE_ENABLED=1

# --- Backup base de donnees ---
BACKUP_PATH=db/backups
BACKUP_RETENTION_DAYS=7

# --- Divers ---
# 1 = developpement uniquement (debogueur interactif Werkzeug = console Python
# accessible depuis le navigateur). Toujours 0 en production (force par install.sh).
FLASK_DEBUG=0

# --- Reseau : acces a distance (regle depuis Admin > Reseau) ---
# Mode : off (local), external (reverse proxy gere par vous), private (VPN
# Tailscale) ou public (Tailscale Funnel). Vide = deduit de TRUSTED_PROXY_COUNT.
REMOTE_ACCESS_MODE=
# Nom DNS de l'appli derriere le reverse proxy externe (ex. tunoova.exemple.com).
PUBLIC_HOSTNAME=
# Nombre de reverse proxies devant l'appli, mis a jour avec le mode :
# 0 = acces direct (off), 1 = un proxy (external, private, public).
TRUSTED_PROXY_COUNT=0
